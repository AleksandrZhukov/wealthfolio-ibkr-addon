{
  "id": "ibkr-multi-import",
  "name": "IBKR Multi-Currency Import",
  "version": "1.2.0",
  "description": "Import IBKR transactions via CSV files or Flex Query API with automatic multi-currency account creation",
  "author": "Nikolai Trukhin",
  "main": "dist/addon.js",
  "sdkVersion": "3.9.0",
  "minWealthfolioVersion": "3.9.0",
  "enabled": true,
  "contributes": {
    "routes": [
      {
        "id": "import"
      },
      {
        "id": "settings",
        "path": "settings"
      }
    ],
    "links": {
      "sidebar": [
        {
          "id": "ibkr-import",
          "route": "import",
          "label": "IBKR Import",
          "icon": "files",
          "order": 150
        },
        {
          "id": "ibkr-settings",
          "route": "settings",
          "label": "IBKR Settings",
          "icon": "sliders",
          "order": 151
        }
      ]
    }
  },
  "hostDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@wealthfolio/addon-sdk": "^3.9.0",
    "@wealthfolio/ui": "^3.9.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "network": {
    "allowedHosts": [
      "ndcdyn.interactivebrokers.com"
    ]
  },
  "permissions": [
    {
      "category": "accounts",
      "functions": [
        "getAll",
        "create"
      ],
      "purpose": "Create and reuse one account per currency"
    },
    {
      "category": "activities",
      "functions": [
        "getAll",
        "import",
        "checkImport"
      ],
      "purpose": "Import IBKR transactions and skip ones already imported"
    },
    {
      "category": "market-data",
      "functions": [
        "searchTicker"
      ],
      "purpose": "Resolve IBKR symbols and ISINs to market tickers"
    },
    {
      "category": "secrets",
      "functions": [
        "get",
        "set",
        "delete"
      ],
      "purpose": "Store the IBKR Flex Query token and query settings"
    },
    {
      "category": "events",
      "functions": [
        "onUpdateComplete"
      ],
      "purpose": "Fetch new Flex Query data after portfolio updates"
    },
    {
      "category": "network",
      "functions": [
        "request"
      ],
      "purpose": "Download Flex Query statements from IBKR (ndcdyn.interactivebrokers.com only)"
    }
  ],
  "homepage": "https://github.com/AleksandrZhukov/wealthfolio-ibkr-addon",
  "repository": "https://github.com/AleksandrZhukov/wealthfolio-ibkr-addon",
  "bugs": "https://github.com/AleksandrZhukov/wealthfolio-ibkr-addon/issues",
  "license": "MIT",
  "keywords": [
    "ibkr",
    "interactive-brokers",
    "import",
    "multi-currency",
    "flex-query"
  ]
}
